@echo off
echo [RESCATE] Matando procesos node anteriores...
taskkill /F /IM node.exe >nul 2>&1

echo [RESCATE] Instalando TODAS las dependencias de UI faltantes...
echo Esto puede tardar 1-2 minutos. Por favor espera...
call pnpm install @radix-ui/react-slot @radix-ui/react-label @radix-ui/react-popover @radix-ui/react-avatar @radix-ui/react-separator @radix-ui/react-alert-dialog @radix-ui/react-dialog @radix-ui/react-dropdown-menu @radix-ui/react-toast @radix-ui/react-tooltip @radix-ui/react-scroll-area @radix-ui/react-checkbox cmdk clsx tailwind-merge lucide-react class-variance-authority date-fns @react-google-maps/api @capacitor/core @capacitor/app

echo [RESCATE] Limpiando cache de Vite...
if exist node_modules\.vite rmdir /s /q node_modules\.vite

echo [RESCATE] Iniciando servidor de desarrollo...
call pnpm run dev --force
