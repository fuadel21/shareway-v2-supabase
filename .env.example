# Frontend (Vite). Never put secret/service-role keys here.
# Copy to .env.local for development.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-only secrets belong in Supabase Edge Function secrets / Vercel
# (not in this file, not in the client bundle):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@shareway.es
# PUSH_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=https://www.shareway.es,https://shareway.es
