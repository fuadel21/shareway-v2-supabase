        "@stripe/stripe-js": "^4.10.0",
        "@supabase/supabase-js": "^2.89.0",
        "browser-image-compression": "^2.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "commander": "^14.0.2",
