        "react-day-picker": "^8.10.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^16.5.3",
        "react-image-crop": "^11.0.10",
        "react-leaflet": "4.2.1",
        "react-router-dom": "^6.30.2",
        "react-spring-bottom-sheet": "^3.4.1",
        "recharts": "^3.7.0",
        "sonner": "^1.7.4",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7"
