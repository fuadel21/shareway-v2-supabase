{
    "name": "shareway-v2",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node scripts/run-vitest-ci.mjs",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint . --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
        "audit:production": "node scripts/check-production-readiness.mjs",
        "audit:sensitive": "node scripts/check-sensitive-client-writes.mjs",
        "audit:seo-pwa": "node scripts/check-seo-pwa-consistency.mjs",
        "audit:assets": "node scripts/check-asset-import-health.mjs",
        "audit:routes": "node scripts/check-public-route-health.mjs",
        "audit:admin": "node scripts/check-admin-command-center-health.mjs",
        "audit:ride-lifecycle": "node scripts/check-ride-lifecycle-integrity.mjs",
        "audit:cancellations": "node scripts/check-cancellation-seat-refund-integrity.mjs",
        "audit:ride-financial": "node scripts/check-ride-financial-integrity.mjs",
        "audit:ride-states": "node scripts/check-ride-state-transition-integrity.mjs",
        "audit:post-ride": "node scripts/check-post-ride-completion-integrity.mjs",
        "audit:ride-chat": "node scripts/check-ride-chat-notification-integrity.mjs",
        "ci:production": "pnpm run audit:production && pnpm run audit:sensitive && pnpm run audit:seo-pwa && pnpm run audit:assets && pnpm run audit:routes && pnpm run audit:admin && pnpm run audit:ride-lifecycle && pnpm run audit:cancellations && pnpm run audit:ride-financial && pnpm run audit:ride-states && pnpm run audit:post-ride && pnpm run audit:ride-chat && pnpm run build"
    },
